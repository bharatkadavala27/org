# Copy to .env and fill real values. NEVER commit .env.

# ===== Server =====
PORT=5000
NODE_ENV=development

# ===== Database (MongoDB Atlas) =====
# URL-encode the password if it contains special characters. Append the DB name.
MONGODB_URI=mongodb+srv://<user>:<db_password>@<cluster>.mongodb.net/samuh_lagna?retryWrites=true&w=majority

# ===== Auth =====
JWT_SECRET=<long_random_string>
JWT_EXPIRES_IN=7d

# ===== First admin (created by seed) =====
SEED_ADMIN_NAME=Trust Admin
SEED_ADMIN_LOGIN=admin@gmail.com
SEED_ADMIN_PASSWORD=<strong_password>

# ===== Cloudinary (file storage) =====
CLOUDINARY_CLOUD_NAME=<cloud_name>
CLOUDINARY_API_KEY=<api_key>
CLOUDINARY_API_SECRET=<api_secret>

# ===== CORS allowlist (comma-separated) =====
CORS_ORIGINS=http://localhost:5173,http://localhost:4173,capacitor://localhost,https://localhost
